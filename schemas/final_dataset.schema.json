{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI SOC Wazuh Final Dataset",
  "description": "Schema for normalized and correlated Wazuh events",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "timestamp",
    "agent_id",
    "agent_name",
    "source_ip",
    "source_port",
    "destination_ip",
    "destination_port",
    "destination_user",
    "rule_id",
    "rule_level",
    "rule_description",
    "rule_groups",
    "raw_event",
    "scenario_id",
    "attack_type",
    "mitre_tactic",
    "mitre_technique",
    "label",
    "confidence",
    "ground_truth_source",
    "correlation_status"
  ],
  "properties": {
    "event_id": {
      "type": "string"
    },
    "timestamp": {
      "type": "string"
    },
    "agent_id": {
      "type": "string"
    },
    "agent_name": {
      "type": "string"
    },
    "source_ip": {
      "type": ["string", "null"]
    },
    "source_port": {
      "type": ["string", "integer", "null"]
    },
    "destination_ip": {
      "type": ["string", "null"]
    },
    "destination_port": {
      "type": ["string", "integer", "null"]
    },
    "destination_user": {
      "type": ["string", "null"]
    },
    "rule_id": {
      "type": "string"
    },
    "rule_level": {
      "type": ["integer", "null"]
    },
    "rule_description": {
      "type": "string"
    },
    "rule_groups": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "raw_event": {
      "type": "string"
    },
    "scenario_id": {
      "type": "string"
    },
    "attack_type": {
      "type": "string"
    },
    "mitre_tactic": {
      "type": "string"
    },
    "mitre_technique": {
      "type": "string"
    },
    "label": {
      "type": "string",
      "enum": [
        "benign",
        "malicious",
        "unlabeled"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "ground_truth_source": {
      "type": "string"
    },
    "ground_truth_run_id": {
      "type": "string"
    },
    "correlation_status": {
      "type": "string",
      "enum": [
        "matched",
        "unmatched",
        "ambiguous"
      ]
    },
    "correlation_delta_seconds": {
      "type": "number",
      "minimum": 0
    }
  }
}
